{
  "$schema": "https://steeltoe.io/schema/latest/schema.json",
  "DisableTokenValidation": "true",
  "ConnectionStrings": {
    "orderDb": "Host=localhost;Port=5432;Database=acme-order;Username=root;Password=rootpassword"
  },
  "Logging": {
    "LogLevel": {
